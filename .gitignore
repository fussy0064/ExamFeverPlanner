.externalNativeBuild/
.cxx/
cmake-build-*/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Google Services (do not commit API keys)
google-services.json

# Proguard
proguard/

# Test results
test-output/
